# Run scripts/setup.sh to create .env from this file and generate the secrets.
# Or copy it to .env by hand. Never commit .env.
# No quotes and no spaces around "=".

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=app
POSTGRES_DB=appdb
# Generated by setup.sh. Postgres only reads this when its volume is first
# created; changing it later needs scripts/reset-db.sh or ALTER USER (see README).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Secrets (generated by setup.sh)
# Encrypts provider tokens stored in the database. Back it up: if it's lost,
# stored tokens can't be decrypted and users must re-link GitHub.
TOKEN_ENCRYPTION_KEY=
# Signs Better Auth sessions (at least 32 characters). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------- Sign-in (auth service)
# Required: the auth service won't start without these, though the login page
# doesn't offer "Sign in with GitHub" yet. Use the org's shared GitHub App
# (the same values as GITHUB_CLIENT_ID/SECRET below). If GitHub sign-in is turned
# on, the App also needs:
#   Redirect URI: <PUBLIC_URL>/api/auth/callback/github
#   (locally: http://localhost:3000/api/auth/callback/github)
#   Account permissions > Email addresses: Read-only
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=

# Optional. Leave empty to hide these sign-in options.
GITLAB_LOGIN_CLIENT_ID=
GITLAB_LOGIN_CLIENT_SECRET=
BITBUCKET_LOGIN_CLIENT_ID=
BITBUCKET_LOGIN_CLIENT_SECRET=

# ---------------------------------------------------------------- Repo access (backend)
# Optional. The org's shared GitHub App, used when a user clicks "Connect GitHub"
# to link their own GitHub account. Don't create your own: get the client ID
# (starts with "Iv", not the numeric App ID) and a client secret from an org
# admin. Without these, linking returns 503.
# The App must list this Redirect URI: <PUBLIC_URL>/api/integrations/github/callback
# Users only see repos where the App is installed, so they may need to install it
# on their own account too.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's URL name, from github.com/apps/<slug>. Shows users an "install the
# App" link so they can choose which repos it can see. Optional.
GITHUB_APP_SLUG=

# ---------------------------------------------------------------- Public address
# Where users open the app. Everything (frontend, /api/auth, /api) is served from
# here, and the GitHub App's redirect URIs must start with it. Defaults shown;
# change for a VM or server, e.g. PUBLIC_URL=http://203.0.113.10:3000
# PUBLIC_URL=http://localhost:3000
# FRONTEND_PORT=3000
# HTTPS: set a hostname that points at this machine, e.g. 203-0-113-10.sslip.io
# (free, maps to the IP in the name). Caddy then gets a certificate automatically.
# Also set PUBLIC_URL=https://<that hostname>, COOKIE_SECURE=true,
# FRONTEND_PORT=80 and HTTPS_PORT=443.
# SITE_ADDRESS=:80
# HTTPS_PORT=3443
# Set to true when PUBLIC_URL is https://
# COOKIE_SECURE=false
# Extra origins allowed to call the auth service (the Vite dev server by default).
# TRUSTED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Outside Docker only
# Docker Compose sets these itself. They're only read when running a service
# on your machine, e.g. `pnpm auth:migrate` in services/auth.
# DATABASE_URL=postgresql://app:<POSTGRES_PASSWORD>@localhost:5432/appdb
# BETTER_AUTH_URL=http://localhost:3000
