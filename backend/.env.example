# Only needed when running the backend outside Docker (e.g. `uvicorn` on your
# machine). Under Docker Compose these come from the root .env instead.
# Copy to backend/.env. Every key maps to a field in app/core/config.py.

# Required
DATABASE_URL=postgresql://app:password@localhost:5432/appdb
REDIS_URL=redis://localhost:6379
# Must match the root .env, or stored GitHub tokens can't be decrypted.
TOKEN_ENCRYPTION_KEY=

# The org's shared GitHub App, used to link a user's GitHub account for repo
# access. Same values as GITHUB_CLIENT_ID/SECRET in the root .env; ask an org
# admin, don't create your own. Optional: GitHub linking returns 503 without it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback

FRONTEND_URL=http://localhost:3000
# Set to true once served over HTTPS.
COOKIE_SECURE=false

# The auth service; outside Docker it is on localhost.
AUTH_SERVICE_URL=http://localhost:3001
