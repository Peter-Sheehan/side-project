{
  "name": "source-control-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "auth:generate": "auth generate --config ./src/auth.ts",
    "auth:migrate": "dotenv -e ../../.env -- auth migrate --config ./src/auth.ts",
    "auth:migrate:docker": "auth migrate --config ./src/auth.ts --yes"
  },
  "dependencies": {
    "better-auth": "^1.4.0",
    "nodemailer": "10.0.13",
    "pg": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "auth": "1.7.7",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}